{
  "name": "@careplan/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulated": "vite --mode emulator",
    "build": "tsc --noEmit && vite build && node scripts/check-bundle.mjs",
    "build:emulated": "vite build --mode emulator --outDir dist-emulated",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --project=desktop --project=phone",
    "test:e2e:emulated": "playwright test --project=emulated",
    "test:rules": "vitest run --config vitest.rules.config.ts"
  },
  "dependencies": {
    "@careplan/engine": "0.1.0",
    "@careplan/import": "0.1.0",
    "@fontsource-variable/public-sans": "5.3.0",
    "@fontsource/public-sans": "5.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-toast": "1.3.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "clsx": "2.1.1",
    "fflate": "0.8.2",
    "firebase": "12.19.0",
    "lucide-react": "1.60.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "26.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
