{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@fixtures/*": ["../../docs/fixtures/*"]
    },
    "types": ["vite/client", "@testing-library/jest-dom"]
  },
  "include": ["src", "test", "e2e", "rules-test", "scripts", "*.ts"]
}